%% Calls control plane (docs/adr/0005-call-control.md). Pinned toolchain:
%% Erlang/OTP 28.5.0.8 and rebar3 3.27.3.
{minimum_otp_vsn, "28"}.
{erl_opts, [debug_info, warnings_as_errors, nowarn_missing_spec]}.
{deps, [{epgsql, "4.8.0"}, {grpcbox, "0.18.0"}]}.
{plugins, [{grpcbox_plugin, "0.9.0"}]}.
{grpc, [
    {protos, ["../api/proto/auth/v1", "../api/proto/chat/v1", "../api/proto/calls/v1"]},
    {gpb_opts, [{module_name_suffix, "_pb"}, {i, "../api/proto"}, type_specs]}
]}.
{dialyzer, [{plt_apps, all_deps}, {warnings, [unmatched_returns, error_handling, extra_return, missing_return]}]}.
{xref_checks, [undefined_function_calls, undefined_functions, locals_not_used, deprecated_function_calls]}.
{xref_ignores, [
    auth_pb, chat_pb, events_pb, calls_pb,
    auth_v_1_auth_service_client, auth_v_1_auth_service_bhvr,
    chat_v_1_chat_service_client, chat_v_1_chat_service_bhvr,
    calls_v_1_calls_service_client, calls_v_1_calls_service_bhvr
]}.
{eunit_opts, [verbose]}.
{profiles, [{test, [{erl_opts, [nowarn_missing_spec]}]}]}.
