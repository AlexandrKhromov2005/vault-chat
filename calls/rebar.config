%% Calls control plane (docs/adr/0005-call-control.md). Pinned toolchain:
%% Erlang/OTP 28.5.0.8 and rebar3 3.27.3.
{minimum_otp_vsn, "28"}.
{erl_opts, [debug_info, warnings_as_errors, warn_missing_spec]}.
{deps, [{epgsql, "4.8.0"}]}.
{dialyzer, [{warnings, [unmatched_returns, error_handling, extra_return, missing_return]}]}.
{xref_checks, [undefined_function_calls, undefined_functions, locals_not_used, deprecated_function_calls]}.
{eunit_opts, [verbose]}.
{profiles, [{test, [{erl_opts, [nowarn_missing_spec]}]}]}.
