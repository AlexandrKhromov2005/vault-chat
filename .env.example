# Vault Chat service configuration. Copy to .env and fill in real values.
# NEVER commit a real .env — see SECURITY.md.
#
# This file configures services started on the host with `go run`. The full
# Docker stack (deployments/docker-compose.yml) sets the same variables itself,
# using Compose service names instead of localhost.

# gRPC listen address of the auth service.
AUTH_GRPC_ADDR=:50051

# Runtime DSN; run cmd/migrate with the owner DSN before starting services.
# Compose runs isolated migration jobs automatically.
AUTH_DATABASE_URL=postgres://auth_app:auth-runtime@localhost:5432/auth_db?sslmode=disable

# RS256 key pair for JWT signing. Generate a development pair with
# scripts/gen-jwt-keys.sh (also sets the permissions Docker Compose needs), or:
#   mkdir -p secrets
#   openssl genrsa -out secrets/auth_jwt_private.pem 4096
#   openssl rsa -in secrets/auth_jwt_private.pem -pubout -out secrets/auth_jwt_public.pem
AUTH_JWT_PRIVATE_KEY_PATH=secrets/auth_jwt_private.pem
AUTH_JWT_PUBLIC_KEY_PATH=secrets/auth_jwt_public.pem

# Token lifetimes.
AUTH_JWT_ACCESS_TTL=15m
AUTH_JWT_REFRESH_TTL=720h

# Argon2id parameters (OWASP-recommended defaults shown).
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_TIME=3
AUTH_ARGON2_PARALLELISM=2

# Log level: debug | info | warn | error
AUTH_LOG_LEVEL=info

# Best-effort session invalidation hints; access checks always use PostgreSQL.
AUTH_REDIS_ADDR=localhost:6379
AUTH_REDIS_PASSWORD=

# Optional account-email workflows; disabled by default. See docs/mail.md.
# Secrets are files, never plaintext environment values. These paths are for
# host processes; VPS containers use deployments/email.env.example instead.
AUTH_MAIL_ENABLED=false
AUTH_PUBLIC_URL=
AUTH_MAIL_KEY_FILE=secrets/mail/outbox.key
AUTH_SMTP_ADDRESS=
AUTH_SMTP_FROM=
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD_FILE=secrets/mail/smtp_password
AUTH_SMTP_TLS_MODE=starttls
AUTH_SMTP_CA_FILE=
AUTH_EMAIL_LEGACY_DEADLINE=

# ---------------------------------------------------------------------------
# API gateway configuration. Every variable is optional; defaults are shown.
# ---------------------------------------------------------------------------

# Public HTTP listen address.
GATEWAY_HTTP_ADDR=:8080

# gRPC address of the auth service (AUTH_GRPC_ADDR above).
GATEWAY_AUTH_GRPC_ADDR=localhost:50051
GATEWAY_CHAT_GRPC_ADDR=localhost:50052

# Redis for rate limiting (matches deployments/docker-compose.yml).
GATEWAY_REDIS_ADDR=localhost:6379
GATEWAY_REDIS_PASSWORD=

# TLS termination (TLS 1.3). Set both to enable; leave both empty for plain
# HTTP in development. Generate a self-signed development pair with:
#   openssl req -x509 -newkey rsa:4096 -nodes -days 365 -subj "/CN=localhost" \
#     -keyout secrets/gateway.key -out secrets/gateway.crt
GATEWAY_TLS_CERT_PATH=
GATEWAY_TLS_KEY_PATH=

# Comma-separated browser origins allowed to call the API, e.g.
# https://chat.example.com,http://localhost:3000. Empty disables CORS; "*"
# allows any origin.
GATEWAY_CORS_ALLOWED_ORIGINS=

# Maximum request body size in bytes.
GATEWAY_MAX_BODY_BYTES=1048576

# Deadline for handling a request, including backend calls.
GATEWAY_REQUEST_TIMEOUT=10s

# Token buckets: refill rate and burst size; see docs/gateway/rate-limits.md.
# IPv6 clients share a /64 bucket. API requests are limited per client IP
# and per user; a valid access token returns the client IP token, so users
# behind one NAT are limited per user.
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_RATE_LIMIT_BURST=30
# Credential requests (login, registration, email and recovery flows), per
# client IP and email or proof, and per client IP. Successful logins and
# registrations return the per-IP token. Enforced locally and through Redis;
# 503 if Redis is unavailable. Auth admits at most two password operations
# and limits each case-insensitive email to burst 5, refill 1/min.
GATEWAY_AUTH_RATE_LIMIT_PER_MINUTE=5
GATEWAY_AUTH_RATE_LIMIT_BURST=5
GATEWAY_AUTH_IP_RATE_LIMIT_PER_MINUTE=10
GATEWAY_AUTH_IP_RATE_LIMIT_BURST=10
# Refresh per client IP; successful refreshes return their token. Without
# Redis only the local bucket applies.
GATEWAY_REFRESH_RATE_LIMIT_PER_MINUTE=30
GATEWAY_REFRESH_RATE_LIMIT_BURST=30

# Log level: debug | info | warn | error
GATEWAY_LOG_LEVEL=info

# WebSocket (GET /api/v1/ws) limits; see docs/chat/realtime.md. Browser
# origins follow GATEWAY_CORS_ALLOWED_ORIGINS. The connection limit applies
# per Gateway instance; a connection whose queue of SEND_BUFFER events fills
# up is closed and its client catches up after reconnecting.
GATEWAY_WS_MAX_CONNECTIONS_PER_USER=5
# Connections per instance, and those still waiting for a valid auth frame
# (at most the total). Upgrades beyond them get 503 with Retry-After; unlike
# the rate limit, these limits hold while Redis is down.
GATEWAY_WS_MAX_CONNECTIONS=10000
GATEWAY_WS_MAX_UNAUTHENTICATED_CONNECTIONS=1000
GATEWAY_WS_SEND_BUFFER=64
# Time to send the auth frame after connecting; also bounds token checks.
GATEWAY_WS_AUTH_TIMEOUT=5s
GATEWAY_WS_PING_INTERVAL=30s
GATEWAY_WS_WRITE_TIMEOUT=10s

# ---------------------------------------------------------------------------
# Chat room service. The database is separate from Auth (port 5433 in Compose).
# ---------------------------------------------------------------------------
CHAT_GRPC_ADDR=:50052
CHAT_AUTH_GRPC_ADDR=localhost:50051
CHAT_DATABASE_URL=postgres://chat_app:chat-runtime@localhost:5433/chat_db?sslmode=disable
CHAT_REQUEST_TIMEOUT=10s
CHAT_LOG_LEVEL=info

# Redis Pub/Sub for real-time events, published after each committed change
# (the same Redis as GATEWAY_REDIS_ADDR). Publishing is best effort: when Redis
# is unreachable, changes still succeed and clients recover through catch-up.
CHAT_REDIS_ADDR=localhost:6379
CHAT_REDIS_PASSWORD=
# Requests only enqueue events; one worker publishes them. A full queue drops
# new events (logged with a running total). On shutdown the queue is drained
# for at most CHAT_EVENT_DRAIN_TIMEOUT.
CHAT_EVENT_QUEUE_SIZE=1024
CHAT_EVENT_PUBLISH_TIMEOUT=1s
CHAT_EVENT_DRAIN_TIMEOUT=5s

# Optional for local go-run; Compose wires these automatically.
CHAT_MEDIA_GRPC_ADDR=localhost:50053
GATEWAY_MEDIA_GRPC_ADDR=localhost:50053
MEDIA_GRPC_ADDR=:50053
MEDIA_DATABASE_URL=postgres://media_app:media-runtime@localhost:5434/media_db?sslmode=disable
MEDIA_AUTH_GRPC_ADDR=localhost:50051
MEDIA_CHAT_GRPC_ADDR=localhost:50052
MEDIA_S3_ENDPOINT=localhost:9000
MEDIA_S3_ACCESS_KEY=vaultmedia
MEDIA_S3_SECRET_KEY=vaultmedia-secret
MEDIA_S3_BUCKET=vault-chat-media
MEDIA_S3_SECURE=false
MEDIA_LOG_LEVEL=info

# Optional private metrics listeners. Empty disables the listener. In Docker
# use deployments/monitoring/app.yml, which publishes only on host loopback.
AUTH_METRICS_ADDR=
CHAT_METRICS_ADDR=
MEDIA_METRICS_ADDR=
GATEWAY_METRICS_ADDR=

# Optional internal mTLS. All fields are required when mtls is selected.
# The supplied directory must contain ca.pem, tls.crt and tls.key for this service.
RPC_TLS_MODE=plaintext
RPC_TLS_DIR=
# Used by container gRPC healthcheck; service entrypoints have fixed identities.
RPC_TLS_SERVICE=
