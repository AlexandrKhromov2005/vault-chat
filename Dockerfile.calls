FROM erlang:28.5.0.8@sha256:fe3425a5d92e03aa3696b951b128f6c55c6f76d4ddf341c8e511ae9c515ac8d2 AS build
ARG REBAR3_SHA256=f1d87d78decfc56b87d971c75ee6355698ec0c49fadd57f2c056043b7ca291b5
RUN wget -q https://github.com/erlang/rebar3/releases/download/3.27.3/rebar3 -O /usr/local/bin/rebar3 && \
    echo "$REBAR3_SHA256  /usr/local/bin/rebar3" | sha256sum -c - && chmod 755 /usr/local/bin/rebar3
WORKDIR /src
COPY calls ./calls
COPY api/proto ./api/proto
RUN cd calls && rebar3 compile

FROM erlang:28.5.0.8@sha256:fe3425a5d92e03aa3696b951b128f6c55c6f76d4ddf341c8e511ae9c515ac8d2
COPY calls/bin /usr/local/bin/
COPY --from=build /src/calls/_build/default/lib /app/lib
RUN rm -f /app/lib/vault_calls/priv
COPY calls/priv /app/lib/vault_calls/priv
RUN chmod 755 /usr/local/bin/calls-*
ENV ERL_FLAGS="+Q 4096 +S 2:2 +A 2 +SDio 2 +SDcpu 2"
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/calls-start"]
