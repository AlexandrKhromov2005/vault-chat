# Copy to .env.email only after preparing secrets/mail; see docs/mail.md.
# The VPS helper detects this file and enables the Auth-only email overlay.
# Public configuration only: never put passwords or the encryption key here.
# For temporary relay maintenance, set false while preserving this file and key.
AUTH_MAIL_ENABLED=true
AUTH_PUBLIC_URL=https://chat.example.invalid
AUTH_SMTP_ADDRESS=smtp.example.invalid:587
AUTH_SMTP_FROM=Vault Chat <sender@example.invalid>
AUTH_SMTP_USERNAME=replace-with-relay-user
AUTH_SMTP_PASSWORD_FILE=/run/secrets/mail/smtp_password
# starttls (typically 587) or tls (implicit TLS, typically 465); no plaintext mode.
AUTH_SMTP_TLS_MODE=starttls
# Optional custom CA bundle stored in the same private mail directory.
AUTH_SMTP_CA_FILE=
# Optional RFC3339 transition deadline; no implicit deadline for legacy accounts.
AUTH_EMAIL_LEGACY_DEADLINE=
