[Unit]
Description=Vault Chat messenger
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/vault-chat
ExecStart=/opt/vault-chat/scripts/vps.sh up
ExecStop=/usr/bin/docker compose -p vault-chat --env-file .env.vps -f deployments/docker-compose.vps.yml stop
TimeoutStartSec=300
TimeoutStopSec=120
[Install]
WantedBy=multi-user.target
