# Copy to .env.push only after preparing secrets/push; see docs/push.md.
# The VPS helper detects this file and enables the push overlay: the broker,
# and push signals in Chat and Auth.
# Path inside the container, not a secret. Leave empty to pause push while
# keeping the file and the key: then Chat publishes no signals and Auth
# consumes none. Push also needs mTLS and secrets/rpc/nats (docs/push.md).
AUTH_PUSH_FCM_CREDENTIALS_FILE=/run/secrets/push/fcm.json
