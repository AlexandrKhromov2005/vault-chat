{"uid": "vault-chat-services", "title": "Vault Chat · Сервисы и API", "schemaVersion": 39, "version": 1, "refresh": "15s", "timezone": "browser", "time": {"from": "now-1h", "to": "now"}, "tags": ["vault-chat", "services"], "description": "Живые метрики Vault Chat. Отсутствие данных не означает нулевую нагрузку.", "links": [{"title": "Сервисы и API", "type": "link", "url": "/d/vault-chat-services", "targetBlank": false}, {"title": "Realtime", "type": "link", "url": "/d/vault-chat-realtime", "targetBlank": false}, {"title": "Сервер и эксплуатация", "type": "link", "url": "/d/vault-chat-operations", "targetBlank": false}, {"title": "Обзор", "type": "link", "url": "/d/vault-chat-overview", "targetBlank": false}],"panels":[
{"id": 1, "title": "Доступность сервисов", "type": "stat", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "up{job=~\"auth|chat|media|gateway\"}", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 2, "title": "HTTP-запросы / с", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "sum(rate(vault_http_requests_total{kind=\"api\"}[$__rate_interval]))", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 3, "title": "Доля HTTP 5xx", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "(sum(rate(vault_http_requests_total{kind=\"api\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(vault_http_requests_total{kind=\"api\"}[$__rate_interval])),0.001)", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 4, "title": "HTTP задержка p95", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "histogram_quantile(0.95,sum by(le)(rate(vault_http_request_duration_seconds_bucket{kind=\"api\"}[$__rate_interval])))", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 5, "title": "RPC-запросы / с", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "targets": [{"expr": "sum by(service)(rate(vault_grpc_requests_total{method!~\"/grpc.health.*\"}[$__rate_interval]))", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 6, "title": "RPC задержка p95", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "targets": [{"expr": "histogram_quantile(0.95,sum by(service,le)(rate(vault_grpc_request_duration_seconds_bucket{method!~\"/grpc.health.*\"}[$__rate_interval])))", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 7, "title": "Память приложений RSS", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}, "targets": [{"expr": "process_resident_memory_bytes{service=~\"auth|chat|media|gateway\"}", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 8, "title": "Доля неожиданных RPC-ошибок", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}, "targets": [{"expr": "(sum by(service)(rate(vault_grpc_requests_total{code=~\"Internal|Unavailable|DeadlineExceeded|DataLoss|Unknown\",method!~\"/grpc.health.*\"}[$__rate_interval])) or on(service) (0 * sum by(service)(rate(vault_grpc_requests_total{method!~\"/grpc.health.*\"}[$__rate_interval])))) / clamp_min(sum by(service)(rate(vault_grpc_requests_total{method!~\"/grpc.health.*\"}[$__rate_interval])),0.001)", "refId": "A", "legendFormat": "{{service}}"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 9, "title": "Сборка мусора / с", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32}, "targets": [{"expr": "sum by(service)(rate(go_gc_duration_seconds_count{service=~\"auth|chat|media|gateway\"}[$__rate_interval]))", "refId": "A", "legendFormat": "{{service}} {{device}} {{instance}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 10, "title": "Goroutines", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32}, "targets": [{"expr": "go_goroutines{service=~\"auth|chat|media|gateway\"}", "refId": "A", "legendFormat": "{{service}} {{device}} {{instance}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}}
