{"uid": "vault-chat-overview", "title": "Vault Chat overview", "schemaVersion": 39, "version": 1, "refresh": "15s", "timezone": "browser", "time": {"from": "now-1h", "to": "now"},"panels":[
{"id": 1, "title": "Services up", "type": "stat", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "up{job=~\"auth|chat|media|gateway\"}", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
{"id": 2, "title": "API requests / second", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "sum(rate(vault_http_requests_total{kind=\"api\"}[$__rate_interval]))", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}},
{"id": 3, "title": "API 5xx ratio", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "sum(rate(vault_http_requests_total{kind=\"api\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(vault_http_requests_total{kind=\"api\"}[$__rate_interval])),0.001)", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}},
{"id": 4, "title": "API p95 duration", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "histogram_quantile(0.95,sum by(le)(rate(vault_http_request_duration_seconds_bucket{kind=\"api\"}[$__rate_interval])))", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
{"id": 5, "title": "RPC requests / second", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "targets": [{"expr": "sum by(service)(rate(vault_grpc_requests_total{method!~\"/grpc.health.*\"}[$__rate_interval]))", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}},
{"id": 6, "title": "RPC p95 duration", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "targets": [{"expr": "histogram_quantile(0.95,sum by(service,le)(rate(vault_grpc_request_duration_seconds_bucket{method!~\"/grpc.health.*\"}[$__rate_interval])))", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
{"id": 7, "title": "WebSocket admitted / awaiting authentication", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}, "targets": [{"expr": "{__name__=~\"vault_websocket_connections|vault_websocket_unauthenticated_connections\"}", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
{"id": 8, "title": "Event queue occupancy", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}, "targets": [{"expr": "vault_event_queue_pending / vault_event_queue_capacity", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}},
{"id": 9, "title": "Realtime events lost / 5 minutes", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32}, "targets": [{"expr": "increase(vault_events_dropped_total[5m])+increase(vault_events_publish_failures_total[5m])+increase(vault_events_encoding_failures_total[5m])", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
{"id": 10, "title": "Application RSS", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32}, "targets": [{"expr": "process_resident_memory_bytes{service=~\"auth|chat|media|gateway\"}", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}},
{"id": 11, "title": "Host CPU busy", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40}, "targets": [{"expr": "1-avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}},
{"id": 12, "title": "Host RAM used", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40}, "targets": [{"expr": "1-node_memory_MemAvailable_bytes/node_memory_MemTotal_bytes", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}},
{"id": 13, "title": "Root disk available", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48}, "targets": [{"expr": "node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}},
{"id": 14, "title": "Last successful backup age", "type": "stat", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 48}, "targets": [{"expr": "time()-vault_backup_last_success_timestamp_seconds", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
{"id": 15, "title": "Served certificate expires in", "type": "stat", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 56}, "targets": [{"expr": "probe_ssl_earliest_cert_expiry-time()", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
{"id": 16, "title": "Dependency probes", "type": "stat", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 56}, "targets": [{"expr": "probe_success", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
{"id": 17, "title": "Unexpected RPC error ratio", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 64}, "targets": [{"expr": "sum by(service)(rate(vault_grpc_requests_total{code=~\"Internal|Unavailable|DeadlineExceeded|DataLoss|Unknown\",method!~\"/grpc.health.*\"}[$__rate_interval])) / clamp_min(sum by(service)(rate(vault_grpc_requests_total{method!~\"/grpc.health.*\"}[$__rate_interval])),0.001)", "refId": "A", "legendFormat": "{{service}}"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}}
]}
