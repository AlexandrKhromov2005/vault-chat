{"uid": "vault-chat-operations", "title": "Vault Chat · Сервер и эксплуатация", "schemaVersion": 39, "version": 1, "refresh": "15s", "timezone": "browser", "time": {"from": "now-1h", "to": "now"}, "tags": ["vault-chat", "operations"], "description": "Живые метрики Vault Chat. Отсутствие данных не означает нулевую нагрузку.", "links": [{"title": "Сервисы и API", "type": "link", "url": "/d/vault-chat-services", "targetBlank": false}, {"title": "Realtime", "type": "link", "url": "/d/vault-chat-realtime", "targetBlank": false}, {"title": "Сервер и эксплуатация", "type": "link", "url": "/d/vault-chat-operations", "targetBlank": false}, {"title": "Обзор", "type": "link", "url": "/d/vault-chat-overview", "targetBlank": false}],"panels":[
{"id": 1, "title": "Загрузка CPU", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "1-avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 2, "title": "Использование RAM", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "1-node_memory_MemAvailable_bytes/node_memory_MemTotal_bytes", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 3, "title": "Свободное место на диске", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 4, "title": "Возраст резервной копии", "type": "stat", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "time()-vault_backup_last_success_timestamp_seconds", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 5, "title": "До истечения TLS-сертификата", "type": "stat", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "targets": [{"expr": "probe_ssl_earliest_cert_expiry-time()", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 6, "title": "Проверки зависимостей", "type": "stat", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "targets": [{"expr": "probe_success", "refId": "A", "legendFormat": "{{service}} {{job}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 7, "title": "Сетевой трафик / с", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}, "targets": [{"expr": "sum by(device)(rate(node_network_receive_bytes_total{device!=\"lo\"}[$__rate_interval]))", "refId": "A", "legendFormat": "{{service}} {{device}} {{instance}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 8, "title": "Диск занят I/O", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}, "targets": [{"expr": "rate(node_disk_io_time_seconds_total{device=~\"vd[a-z]+|sd[a-z]+|nvme[0-9]+n[0-9]+\"}[$__rate_interval])", "refId": "A", "legendFormat": "{{service}} {{device}} {{instance}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 9, "title": "Задания backup и certbot", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32}, "targets": [{"expr": "{__name__=~\"vault_backup_last_attempt_success|vault_certbot_last_attempt_success\"}", "refId": "A", "legendFormat": "{{service}} {{device}} {{instance}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}},
{"id": 10, "title": "Активные алерты", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "vault-prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32}, "targets": [{"expr": "ALERTS{alertstate=\"firing\"}", "refId": "A", "legendFormat": "{{service}} {{device}} {{instance}} {{__name__}}"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}}
]}
