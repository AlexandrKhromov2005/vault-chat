# Copy is generated by scripts/vps.sh init; never use these empty passwords.
PUBLIC_IP=
VAULT_IMAGE_TAG=
AUTH_DB_PASSWORD=
CHAT_DB_PASSWORD=
MEDIA_DB_PASSWORD=
AUTH_RUNTIME_DB_PASSWORD=
CHAT_RUNTIME_DB_PASSWORD=
MEDIA_RUNTIME_DB_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ROOT_ACCESS_KEY=
S3_ROOT_SECRET_KEY=
# Public age recipient; keep the private identity outside this VPS and its backups.
BACKUP_AGE_RECIPIENT=
# Configured rclone SFTP/S3 destination, e.g. disaster-recovery:vault-chat.
BACKUP_REMOTE=
BACKUP_RCLONE_CONFIG=/etc/vault-chat/rclone.conf
